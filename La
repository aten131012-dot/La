local function CreateToggle(parent, title, default, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -10, 0, 32)
    Btn.BackgroundColor3 = default and getgenv().NexoraConfig.ThemeColor or Color3.fromRGB(35, 35, 42)
    Btn.Text = title .. ": " .. (default and "เปิด [ON]" or "ปิด [OFF]")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.SourceSansBold
    Btn.TextSize = 14
    Btn.Parent = parent
    
    local state = default
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.BackgroundColor3 = state and getgenv().NexoraConfig.ThemeColor or Color3.fromRGB(35, 35, 42)
        Btn.Text = title .. ": " .. (state and "เปิด [ON]" or "ปิด [OFF]")
        callback(state)
    end)
end

