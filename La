local function FindPlayerByName(nameStr)
    nameStr = nameStr:lower()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #nameStr) == nameStr or plr.DisplayName:lower():sub(1, #nameStr) == nameStr then
            return plr
        end
    end
    return nil
end

