-- Visual ESP Components (Name, Distance, Box, Tracers)

local function CreateESP(plr)
    local NameTag = Drawing.new("Text")
    NameTag.Size = 14
    NameTag.Center = true
    NameTag.Outline = true
    NameTag.Color = Color3.fromRGB(255, 50, 50)
    
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = 1
    Tracer.Color = Color3.fromRGB(0, 200, 255)
    
    local Connection
    Connection = RunService.RenderStepped:Connect(function()
        if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and getgenv().NexoraConfig.ESP_Enabled then
            local hrp = plr.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen and IsValidTarget(plr) then
                if getgenv().NexoraConfig.ESP_Names then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                    NameTag.Text = plr.DisplayName .. " [" .. dist .. "m]"
                    NameTag.Position = Vector2.new(pos.X, pos.Y - 25)
                    NameTag.Visible = true
                else
                    NameTag.Visible = false
                end
                
                if getgenv().NexoraConfig.ESP_Tracers then
                    Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                    Tracer.To = Vector2.new(pos.X, pos.Y)
                    Tracer.Visible = true
                else
                    Tracer.Visible = false
                end
            else
                NameTag.Visible = false
                Tracer.Visible = false
            end
        else
            NameTag.Visible = false
            Tracer.Visible = false
            if not plr or not plr.Parent then
                NameTag:Remove()
                Tracer:Remove()
                Connection:Disconnect()
            end
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then CreateESP(plr) end
end
